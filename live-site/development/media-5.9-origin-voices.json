    {
      "id": "origin-976dfb6086191589dc61",
      "speaker": "Dara",
      "voice": "Sandra",
      "text": "We can keep the medical stores here, or send them upriver with the next boat. Neither place has enough.",
      "audio": "origin-976dfb6086191589dc61.mp3",
      "estimated_credits": 3,
      "source_records": [
