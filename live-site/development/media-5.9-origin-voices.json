      "speaker": "Dara",
      "voice": "Sandra",
      "text": "The water took the old sign. We kept the key. There is still a place here for anyone who needs to lie down.",
      "audio": "origin-9b421b40648416c29ac7.mp3",
      "estimated_credits": 3,
      "source_records": [
