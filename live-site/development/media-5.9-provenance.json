      "task_id": "b2bfec2b-27f2-438e-abb8-9759b7502e24",
      "text": "Then why is the microphone on the intake side?",
      "voice": "Elliot",
      "credits": 1,
      "bytes": 40585,
      "sha256": "66f7a8e06fedaf180422d5cbda8da70d31c42958b51ac4ff6238ac7863f4c5a2"
