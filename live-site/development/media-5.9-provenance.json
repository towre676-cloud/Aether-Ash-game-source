      "task_id": "d93d3c50-c3c7-4349-b2f3-a8ef20263525",
      "text": "Your mother promised Rook a reed. She also promised she would rest. Help me keep at least one of those promises.",
      "voice": "Miriam",
      "credits": 3,
      "bytes": 164718,
      "sha256": "18b2eec4344d75fc13a5beaef43b66886d187be0680d4ba4d0ced8b0a99738df"
