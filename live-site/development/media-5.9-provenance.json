      "path": "dist/game/engine2/voices/origin-c8820fceab46cfa02ca8.mp3",
      "task_id": "f5fa7523-ae2e-4d8a-a871-b31da5e1aa53",
      "text": "The charter needs one keeper. The water needs more than one pair of eyes.",
      "voice": "Leslie",
      "credits": 2,
